{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "$id": "http://localhost:8090/calm/namespaces/hackathon/patterns/event-streaming/versions/1.0.0",
  "title": "Event Streaming (Nisshi)",
  "description": "A service that produces and consumes events through a Nisshi broker (Kafka-compatible, nisshi.io), behind an API gateway, with a choice of where the broker keeps its topics.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/node",
          "type": "object",
          "properties": {
            "unique-id": {
              "const": "web-client"
            },
            "node-type": {
              "const": "webclient"
            },
            "name": {
              "const": "Web Client"
            },
            "description": {
              "const": "The browser that sends events and watches them arrive."
            }
          },
          "required": [
            "unique-id",
            "node-type",
            "name",
            "description"
          ]
        },
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/node",
          "type": "object",
          "properties": {
            "unique-id": {
              "const": "api-gateway"
            },
            "node-type": {
              "const": "system"
            },
            "name": {
              "const": "API Gateway"
            },
            "description": {
              "const": "Routes external requests to the stream app."
            },
            "interfaces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "unique-id": {
                      "const": "api-gateway-ingress"
                    },
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "unique-id",
                    "host",
                    "port"
                  ]
                }
              ]
            }
          },
          "required": [
            "unique-id",
            "node-type",
            "name",
            "description"
          ]
        },
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/node",
          "type": "object",
          "properties": {
            "unique-id": {
              "const": "stream-app"
            },
            "node-type": {
              "const": "service"
            },
            "name": {
              "const": "Stream App"
            },
            "description": {
              "const": "The service the developer builds: it produces events to the broker and consumes them back."
            },
            "metadata": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": "string"
                },
                "service-name": {
                  "type": "string"
                },
                "topic": {
                  "type": "string"
                }
              },
              "required": [
                "owner",
                "service-name",
                "topic"
              ]
            },
            "interfaces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "unique-id": {
                      "const": "stream-app-api"
                    },
                    "port": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "unique-id",
                    "port"
                  ]
                }
              ]
            }
          },
          "required": [
            "unique-id",
            "node-type",
            "name",
            "description"
          ]
        },
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/node",
          "type": "object",
          "properties": {
            "unique-id": {
              "const": "nisshi-broker"
            },
            "node-type": {
              "const": "system"
            },
            "name": {
              "const": "Nisshi broker"
            },
            "description": {
              "const": "Nisshi (nisshi.io): a stateless, Kafka-compatible broker with pluggable storage."
            },
            "interfaces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "unique-id": {
                      "const": "nisshi-kafka"
                    },
                    "port": {
                      "const": 9092
                    }
                  },
                  "required": [
                    "unique-id",
                    "port"
                  ]
                }
              ]
            }
          },
          "required": [
            "unique-id",
            "node-type",
            "name",
            "description"
          ]
        },
        {
          "oneOf": [
            {
              "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/node",
              "type": "object",
              "properties": {
                "unique-id": {
                  "const": "broker-postgres"
                },
                "node-type": {
                  "const": "database"
                },
                "name": {
                  "const": "PostgreSQL"
                },
                "description": {
                  "const": "Durable storage for the broker\u2019s topics."
                },
                "interfaces": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": {
                        "unique-id": {
                          "const": "broker-postgres-port"
                        },
                        "port": {
                          "const": 5432
                        }
                      },
                      "required": [
                        "unique-id",
                        "port"
                      ]
                    }
                  ]
                },
                "controls": {
                  "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/controls",
                  "type": "object",
                  "properties": {
                    "security": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "const": "Stored data must be encrypted at rest"
                        },
                        "requirements": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 1,
                          "prefixItems": [
                            {
                              "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/control-detail",
                              "type": "object",
                              "properties": {
                                "requirement-url": {
                                  "const": "http://localhost:8090/calm/domains/hackathon-security/controls/encryption-at-rest/requirement/versions/1.0.0"
                                },
                                "config-url": {
                                  "const": "http://localhost:8090/calm/domains/hackathon-security/controls/encryption-at-rest/configurations/aes-256-kms/versions/1.0.0"
                                }
                              }
                            }
                          ]
                        }
                      },
                      "required": [
                        "description",
                        "requirements"
                      ]
                    }
                  },
                  "required": [
                    "security"
                  ]
                }
              },
              "required": [
                "unique-id",
                "node-type",
                "name",
                "description",
                "controls"
              ]
            },
            {
              "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/node",
              "type": "object",
              "properties": {
                "unique-id": {
                  "const": "broker-sqlite"
                },
                "node-type": {
                  "const": "data-asset"
                },
                "name": {
                  "const": "SQLite"
                },
                "description": {
                  "const": "An embedded SQLite file on the broker\u2019s own volume: one broker, no database to run."
                }
              },
              "required": [
                "unique-id",
                "node-type",
                "name",
                "description"
              ]
            }
          ]
        }
      ]
    },
    "relationships": {
      "type": "array",
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/relationship",
          "type": "object",
          "properties": {
            "unique-id": {
              "const": "web-client-api-gateway"
            },
            "description": {
              "const": "The browser calls the stream app through the gateway"
            },
            "protocol": {
              "const": "HTTPS"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": {
                    "node": "web-client"
                  },
                  "destination": {
                    "node": "api-gateway"
                  }
                }
              }
            },
            "controls": {
              "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/controls",
              "type": "object",
              "properties": {
                "security": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "const": "Connections must be permitted and encrypted in transit"
                    },
                    "requirements": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "prefixItems": [
                        {
                          "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/control-detail",
                          "type": "object",
                          "properties": {
                            "requirement-url": {
                              "const": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/requirement/versions/1.0.0"
                            },
                            "config-url": {
                              "const": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/configurations/https/versions/1.0.0"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "description",
                    "requirements"
                  ]
                }
              },
              "required": [
                "security"
              ]
            }
          },
          "required": [
            "unique-id",
            "description",
            "relationship-type",
            "protocol",
            "controls"
          ]
        },
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/relationship",
          "type": "object",
          "properties": {
            "unique-id": {
              "const": "api-gateway-stream-app"
            },
            "description": {
              "const": "The gateway forwards requests to the stream app"
            },
            "protocol": {
              "const": "HTTPS"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": {
                    "node": "api-gateway"
                  },
                  "destination": {
                    "node": "stream-app"
                  }
                }
              }
            },
            "controls": {
              "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/controls",
              "type": "object",
              "properties": {
                "security": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "const": "Connections must be permitted and encrypted in transit"
                    },
                    "requirements": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "prefixItems": [
                        {
                          "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/control-detail",
                          "type": "object",
                          "properties": {
                            "requirement-url": {
                              "const": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/requirement/versions/1.0.0"
                            },
                            "config-url": {
                              "const": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/configurations/https/versions/1.0.0"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "description",
                    "requirements"
                  ]
                }
              },
              "required": [
                "security"
              ]
            }
          },
          "required": [
            "unique-id",
            "description",
            "relationship-type",
            "protocol",
            "controls"
          ]
        },
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/relationship",
          "type": "object",
          "properties": {
            "unique-id": {
              "const": "stream-app-nisshi-broker"
            },
            "description": {
              "const": "The stream app produces and consumes events with the Kafka protocol"
            },
            "protocol": {
              "const": "TCP"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": {
                    "node": "stream-app"
                  },
                  "destination": {
                    "node": "nisshi-broker"
                  }
                }
              }
            },
            "controls": {
              "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/controls",
              "type": "object",
              "properties": {
                "security": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "const": "Connections to the broker must be permitted"
                    },
                    "requirements": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "prefixItems": [
                        {
                          "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/control-detail",
                          "type": "object",
                          "properties": {
                            "requirement-url": {
                              "const": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/requirement/versions/1.0.0"
                            },
                            "config-url": {
                              "const": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/configurations/datastore/versions/1.0.0"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "description",
                    "requirements"
                  ]
                }
              },
              "required": [
                "security"
              ]
            }
          },
          "required": [
            "unique-id",
            "description",
            "relationship-type",
            "protocol",
            "controls"
          ]
        },
        {
          "oneOf": [
            {
              "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/relationship",
              "type": "object",
              "properties": {
                "unique-id": {
                  "const": "nisshi-broker-postgres"
                },
                "description": {
                  "const": "The broker stores its topics in PostgreSQL"
                },
                "protocol": {
                  "const": "JDBC"
                },
                "relationship-type": {
                  "const": {
                    "connects": {
                      "source": {
                        "node": "nisshi-broker"
                      },
                      "destination": {
                        "node": "broker-postgres"
                      }
                    }
                  }
                },
                "controls": {
                  "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/controls",
                  "type": "object",
                  "properties": {
                    "security": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "const": "Connections to the data store must be permitted and encrypted"
                        },
                        "requirements": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 1,
                          "prefixItems": [
                            {
                              "$ref": "https://calm.finos.org/release/1.3/meta/control.json#/defs/control-detail",
                              "type": "object",
                              "properties": {
                                "requirement-url": {
                                  "const": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/requirement/versions/1.0.0"
                                },
                                "config-url": {
                                  "const": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/configurations/datastore/versions/1.0.0"
                                }
                              }
                            }
                          ]
                        }
                      },
                      "required": [
                        "description",
                        "requirements"
                      ]
                    }
                  },
                  "required": [
                    "security"
                  ]
                }
              },
              "required": [
                "unique-id",
                "description",
                "relationship-type",
                "protocol",
                "controls"
              ]
            },
            {
              "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/relationship",
              "type": "object",
              "properties": {
                "unique-id": {
                  "const": "nisshi-broker-sqlite"
                },
                "description": {
                  "const": "The broker keeps its topics in an embedded SQLite file"
                },
                "relationship-type": {
                  "const": {
                    "composed-of": {
                      "container": "nisshi-broker",
                      "nodes": [
                        "broker-sqlite"
                      ]
                    }
                  }
                }
              },
              "required": [
                "unique-id",
                "description",
                "relationship-type"
              ]
            }
          ]
        },
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/relationship",
          "type": "object",
          "properties": {
            "unique-id": {
              "const": "broker-storage"
            },
            "description": {
              "const": "Where does the Nisshi broker keep its topics?"
            },
            "relationship-type": {
              "type": "object",
              "properties": {
                "options": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "oneOf": [
                        {
                          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/decision",
                          "type": "object",
                          "properties": {
                            "description": {
                              "const": "PostgreSQL"
                            },
                            "nodes": {
                              "const": [
                                "broker-postgres"
                              ]
                            },
                            "relationships": {
                              "const": [
                                "nisshi-broker-postgres"
                              ]
                            }
                          }
                        },
                        {
                          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/decision",
                          "type": "object",
                          "properties": {
                            "description": {
                              "const": "SQLite on the broker\u2019s volume"
                            },
                            "nodes": {
                              "const": [
                                "broker-sqlite"
                              ]
                            },
                            "relationships": {
                              "const": [
                                "nisshi-broker-sqlite"
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ],
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            }
          },
          "required": [
            "unique-id",
            "description",
            "relationship-type"
          ]
        }
      ]
    }
  },
  "required": [
    "nodes",
    "relationships"
  ]
}
