{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://localhost:8090/calm/domains/hackathon-security/controls/permitted-connection/requirement/versions/1.0.0",
  "title": "Permitted Connection",
  "description": "Every connection between components must name its protocol and give a business reason.",
  "type": "object",
  "allOf": [
    { "$ref": "https://calm.finos.org/release/1.3/meta/control-requirement.json" }
  ],
  "properties": {
    "control-id": { "const": "hs-001" },
    "name": { "const": "Permitted Connection" },
    "description": { "const": "Every connection between components must name its protocol and give a business reason." },
    "reason": { "type": "string", "description": "Why the connection is needed" },
    "protocol": { "enum": ["HTTP", "HTTPS", "JDBC", "TCP", "AMQP", "TLS"] }
  },
  "required": ["control-id", "name", "description", "reason", "protocol"]
}
