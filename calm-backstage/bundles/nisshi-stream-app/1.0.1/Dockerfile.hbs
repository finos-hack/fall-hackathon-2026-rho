# Generated by the starter nisshi-stream-app {{starterVersion}}
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --no-audit --no-fund
COPY src/ /app/src/
USER node
ENV PORT={{servicePort}} KAFKAJS_NO_PARTITIONER_WARNING=1
EXPOSE {{servicePort}}
CMD ["node", "src/server.js"]
