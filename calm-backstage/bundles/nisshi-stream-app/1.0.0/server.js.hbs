// Generated by the starter nisshi-stream-app {{starterVersion}} for {{serviceName}}: produces and consumes events
// through a Nisshi broker (Kafka-compatible, https://nisshi.io) with kafkajs. The starter contract: listen on
// $PORT, answer GET /health, serve the page and /api/info, read what the deployment rules tell it.
'use strict';

const fs = require('node:fs');
const http = require('node:http');
const net = require('node:net');
const os = require('node:os');
const path = require('node:path');
const { Kafka, logLevel, Partitioners } = require('kafkajs');

const PORT = Number(process.env.PORT || {{servicePort}});
const SERVICE = process.env.SERVICE_NAME || {{{json serviceName}}};
const TOPIC = process.env.KAFKA_TOPIC || {{{json topic}}};
const BROKERS = (process.env.KAFKA_BOOTSTRAP_SERVERS || 'nisshi-broker:9092').split(',');
const STARTED_AT = new Date().toISOString();
const PAGE = fs.readFileSync(path.join(__dirname, 'index.html'));
const KEEP = 50;

let connections = [];
try {
  connections = JSON.parse(process.env.CALM_CONNECTIONS || '[]');
} catch {
  console.error('CALM_CONNECTIONS is not JSON; no connections are checked');
}

// kafkajs logs every failed fetch while the broker restarts; the app logs what matters itself.
const kafka = new Kafka({ clientId: SERVICE, brokers: BROKERS, logLevel: logLevel.NOTHING, retry: { retries: 3 } });
const producer = kafka.producer({ createPartitioner: Partitioners.DefaultPartitioner });
const consumer = kafka.consumer({ groupId: `${SERVICE}-ui` });
const received = [];
let broker = { state: 'connecting', detail: `connecting to ${BROKERS.join(', ')}` };
let produced = 0;

/** Creates the topic when the broker does not have it (a new broker on empty storage has no topics). */
async function ensureTopic() {
  const admin = kafka.admin();
  await admin.connect();
  try {
    if (!(await admin.listTopics()).includes(TOPIC)) {
      await admin.createTopics({ topics: [{ topic: TOPIC, numPartitions: 1 }] });
      console.log(`created the topic ${TOPIC}`);
    }
  } finally {
    await admin.disconnect();
  }
}

/** Creates the topic, connects the producer and the consumer; retried every 3 s until the broker answers. */
async function connect() {
  for (;;) {
    try {
      await ensureTopic();
      await producer.connect();
      await consumer.connect();
      await consumer.subscribe({ topic: TOPIC, fromBeginning: true });
      await consumer.run({
        eachMessage: async ({ partition, message }) => {
          let value;
          try {
            value = JSON.parse(message.value.toString());
          } catch {
            value = { text: message.value.toString() };
          }
          received.unshift({ partition, offset: message.offset, key: message.key?.toString() ?? null, ...value,
            receivedAt: new Date().toISOString() });
          received.length = Math.min(received.length, KEEP);
        },
      });
      broker = { state: 'connected', detail: `topic ${TOPIC} on ${BROKERS.join(', ')}` };
      console.log(`connected to ${BROKERS.join(', ')}, topic ${TOPIC}`);
      return;
    } catch (e) {
      broker = { state: 'waiting', detail: `${BROKERS.join(', ')}: ${e.message}` };
      console.error(`broker not ready: ${e.message}`);
      await new Promise(r => setTimeout(r, 3000));
    }
  }
}

function info() {
  return {
    service: SERVICE,
    description: {{{json description}}},
    owner: process.env.SERVICE_OWNER || {{{json owner}}},
    starter: 'nisshi-stream-app@{{starterVersion}}',
    runtime: `Node ${process.versions.node} with kafkajs 2.2.4`,
    deployRules: process.env.CALM_DEPLOY_RULES || null,
    architecture: process.env.CALM_ARCHITECTURE || {{{json architectureId}}},
    pattern: process.env.CALM_PATTERN || {{{json patternId}}},
    hostname: os.hostname(),
    startedAt: STARTED_AT,
    topic: TOPIC,
    broker,
  };
}

function isOpen(host, port) {
  return new Promise(resolve => {
    const socket = net.connect({ host, port });
    const done = open => {
      socket.destroy();
      resolve(open);
    };
    socket.setTimeout(2000);
    socket.once('connect', () => done(true));
    socket.once('timeout', () => done(false));
    socket.once('error', () => done(false));
  });
}

function send(res, status, body) {
  res.writeHead(status, { 'content-type': 'application/json' });
  res.end(`${JSON.stringify(body, null, 2)}\n`);
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    let s = '';
    req.on('data', c => {
      s += c;
      if (s.length > 10000) {
        reject(new Error('body too large'));
        req.destroy();
      }
    });
    req.on('end', () => resolve(s));
    req.on('error', reject);
  });
}

const server = http.createServer(async (req, res) => {
  const p = new URL(req.url, 'http://localhost').pathname;
  try {
    if (req.method === 'GET' && (p === '/' || p === '/index.html')) {
      res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' });
      res.end(PAGE);
    } else if (req.method === 'GET' && p === '/health') {
      send(res, 200, { status: 'ok' });
    } else if (req.method === 'GET' && p === '/api/info') {
      send(res, 200, info());
    } else if (req.method === 'GET' && p === '/api/connections') {
      send(res, 200, await Promise.all(connections.map(async c => ({ ...c, open: await isOpen(c.host, c.port) }))));
    } else if (req.method === 'GET' && p === '/api/messages') {
      send(res, 200, { topic: TOPIC, broker, produced, messages: received });
    } else if (req.method === 'POST' && p === '/api/messages') {
      if (broker.state !== 'connected') {
        send(res, 503, { error: `the broker is not connected yet (${broker.detail})` });
        return;
      }
      const body = JSON.parse((await readBody(req)) || '{}');
      const text = String(body.text ?? '').slice(0, 500) || 'hello';
      const event = { text, from: os.hostname(), sentAt: new Date().toISOString() };
      const [meta] = await producer.send({ topic: TOPIC, messages: [{ key: SERVICE, value: JSON.stringify(event) }] });
      produced++;
      send(res, 201, { topic: TOPIC, partition: meta.partition, offset: meta.baseOffset, event });
    } else {
      send(res, 404, { error: 'not found' });
    }
  } catch (e) {
    send(res, 500, { error: e.message });
  }
});

server.listen(PORT, '0.0.0.0', () => console.log(`${SERVICE} listening on ${PORT}`));
connect();
// A broker that restarts on empty storage (SQLite on its own volume, memory) comes back without the topic.
setInterval(() => {
  if (broker.state === 'connected') {
    ensureTopic().catch(e => console.error(`topic check failed: ${e.message}`));
  }
}, 5000);
for (const signal of ['SIGTERM', 'SIGINT']) {
  process.on(signal, async () => {
    await Promise.allSettled([consumer.disconnect(), producer.disconnect()]);
    server.close(() => process.exit(0));
  });
}
