# Generated by the deployment rules {{rules.name}} {{rules.version}}: the gateway forwards every request to the service.
apiVersion: v1
kind: ConfigMap
metadata:
  name: gateway-config
  labels:
    calm.finos.org/node: {{gatewayNode}}
data:
  default.conf: |
    server {
      listen {{gatewayContainerPort}};

      location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
      }

      location / {
        proxy_pass http://{{appNode}}:{{servicePort}};
        proxy_set_header Host $host;
      }
    }
