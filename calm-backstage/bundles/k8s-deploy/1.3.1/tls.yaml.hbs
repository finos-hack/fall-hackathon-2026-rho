# Generated by the deployment rules {{rules.name}} {{rules.version}}: TLS between workloads joined by an HTTPS
# relationship. cert-manager (installed by `yarn k8s:up`) issues a self-signed CA in the namespace and, from it, a
# certificate per TLS workload for its Service name. The workload's nginx sidecar serves it on {{tls.containerPort}}; the
# source trusts the CA. Listed in kustomization.yaml only when there is such a relationship.
{{#if tlsWorkloads.length}}
---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: {{tls.selfSignedIssuer}}
spec:
  selfSigned: {}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{tls.ca}}
spec:
  isCA: true
  commonName: {{tls.ca}}
  secretName: {{tls.ca}}
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    kind: Issuer
    name: {{tls.selfSignedIssuer}}
---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: {{tls.ca}}
spec:
  ca:
    secretName: {{tls.ca}}
{{/if}}
{{#each tlsWorkloads}}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{tls.secretName}}
{{#if renamed}}
  annotations:
    calm.finos.org/unique-id: {{{json id}}}
{{/if}}
  labels:
    calm.finos.org/node: {{k8sName}}
spec:
  secretName: {{tls.secretName}}
  dnsNames:
    - {{k8sName}}
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    kind: Issuer
    name: {{../tls.ca}}
---
# The sidecar's nginx: replaces the image's default.conf, which would listen on 8080 too.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{tls.configMap}}
{{#if renamed}}
  annotations:
    calm.finos.org/unique-id: {{{json id}}}
{{/if}}
  labels:
    calm.finos.org/node: {{k8sName}}
data:
  default.conf: |
    server {
      listen {{tls.containerPort}} ssl;
      ssl_certificate {{../tls.certDir}}/tls.crt;
      ssl_certificate_key {{../tls.certDir}}/tls.key;

      location / {
        proxy_pass http://localhost:{{containerPort}};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
      }
    }
{{/each}}
