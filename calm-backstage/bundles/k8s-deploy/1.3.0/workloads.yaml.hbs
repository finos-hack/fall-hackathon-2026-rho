# Generated by the deployment rules {{rules.name}} {{rules.version}}: one Deployment and one Service per in-cluster node.
{{#each workloads}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{id}}
  labels:
    calm.finos.org/node: {{id}}
    calm.finos.org/deploy-rules: {{../rules.name}}-{{../rules.version}}
{{#if ../hardening}}
    app.kubernetes.io/name: {{id}}
    app.kubernetes.io/part-of: {{../serviceName}}
    app.kubernetes.io/managed-by: flux
{{/if}}
spec:
  replicas: 1
{{#if stateful}}
  # Its data is in the pod (no volume claim): never two at once during a rollout. The old pod stops before the new
  # one starts. (Not type Recreate: switching an existing Deployment to Recreate is refused while it holds
  # rollingUpdate settings, and server-side apply cannot remove them.)
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 0
      maxUnavailable: 1
{{/if}}
  selector:
    matchLabels:
      calm.finos.org/node: {{id}}
  template:
    metadata:
      labels:
        calm.finos.org/node: {{id}}
        calm.finos.org/deploy-rules: {{../rules.name}}-{{../rules.version}}
{{#if ../hardening}}
        app.kubernetes.io/name: {{id}}
        app.kubernetes.io/part-of: {{../serviceName}}
{{/if}}
    spec:
      enableServiceLinks: false
{{#if ../hardening}}
      automountServiceAccountToken: false
{{/if}}
      containers:
        - name: {{id}}
          image: {{image}}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{containerPort}}
{{#if env.length}}
          env:
{{#each env}}
            - name: {{name}}
              value: {{{json value}}}
{{/each}}
{{/if}}
          readinessProbe:
{{#if httpProbePath}}
            httpGet:
              path: {{httpProbePath}}
              port: {{containerPort}}
{{else}}
            tcpSocket:
              port: {{containerPort}}
{{/if}}
{{#if probeDelay}}
            initialDelaySeconds: {{probeDelay}}
{{/if}}
            periodSeconds: 5
            failureThreshold: 24
{{#if ../hardening}}
          livenessProbe:
{{#if httpProbePath}}
            httpGet:
              path: {{httpProbePath}}
              port: {{containerPort}}
{{else}}
            tcpSocket:
              port: {{containerPort}}
{{/if}}
            initialDelaySeconds: 60
            periodSeconds: 10
{{/if}}
          resources:
            requests:
              cpu: {{cpu}}
              memory: {{memory}}
{{#if ../hardening}}
            limits:
              cpu: {{cpuLimit}}
              memory: {{memoryLimit}}
{{/if}}
{{#if mounts.length}}
          volumeMounts:
{{#each mounts}}
            - name: {{name}}
              mountPath: {{mountPath}}
{{#if readOnly}}
              readOnly: true
{{/if}}
{{/each}}
{{/if}}
{{#if tls}}
        # Serves TLS for the HTTPS relationships to this node and proxies to the container above over localhost.
        - name: tls-proxy
          image: {{../tls.image}}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{tls.containerPort}}
          readinessProbe:
            tcpSocket:
              port: {{tls.containerPort}}
            periodSeconds: 5
            failureThreshold: 24
{{#if ../hardening}}
          livenessProbe:
            tcpSocket:
              port: {{tls.containerPort}}
            initialDelaySeconds: 10
            periodSeconds: 10
{{/if}}
          resources:
            requests:
              cpu: {{../tls.cpu}}
              memory: {{../tls.memory}}
{{#if ../hardening}}
            limits:
              cpu: {{../tls.cpuLimit}}
              memory: {{../tls.memoryLimit}}
{{/if}}
          volumeMounts:
            - name: tls-proxy-config
              mountPath: /etc/nginx/conf.d
            - name: tls
              mountPath: {{../tls.certDir}}
              readOnly: true
{{/if}}
{{#if podVolumes.length}}
      volumes:
{{#each podVolumes}}
        - name: {{name}}
{{#if configMap}}
          configMap:
            name: {{configMap}}
{{/if}}
{{#if emptyDir}}
          emptyDir: {}
{{/if}}
{{#if secret}}
          secret:
            secretName: {{secret}}
{{#if items}}
            items:
{{#each items}}
              - key: {{this}}
                path: {{this}}
{{/each}}
{{/if}}
{{/if}}
{{/each}}
{{/if}}
---
apiVersion: v1
kind: Service
metadata:
  name: {{id}}
  labels:
    calm.finos.org/node: {{id}}
spec:
  selector:
    calm.finos.org/node: {{id}}
  ports:
{{#if tls}}
    - name: http
      port: {{servicePort}}
      targetPort: {{containerPort}}
    - name: https
      port: {{tls.servicePort}}
      targetPort: {{tls.containerPort}}
{{else}}
    - port: {{servicePort}}
      targetPort: {{containerPort}}
{{/if}}
{{/each}}
