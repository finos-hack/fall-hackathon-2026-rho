# Generated by the deployment rules {{rules.name}} {{rules.version}}: the gateway forwards every request to the service{{#if gatewayTls}}
# over TLS, and checks the service's certificate against the namespace's CA (tls.yaml){{/if}}.
apiVersion: v1
kind: ConfigMap
metadata:
  name: gateway-config
  labels:
    calm.finos.org/node: {{gatewayNode}}
data:
  default.conf: |
    server {
      listen {{gatewayContainerPort}};

      location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
      }

      location / {
{{#if gatewayTls}}
        proxy_pass https://{{appNode}}:{{tls.servicePort}};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate {{tls.caDir}}/ca.crt;
        proxy_ssl_name {{appNode}};
        proxy_ssl_server_name on;
{{else}}
        proxy_pass http://{{appNode}}:{{servicePort}};
{{/if}}
        proxy_set_header Host $host;
      }
    }
