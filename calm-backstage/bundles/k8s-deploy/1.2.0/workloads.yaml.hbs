# Generated by the deployment rules {{rules.name}} {{rules.version}}: one Deployment and one Service per in-cluster node.
{{#each workloads}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{id}}
  labels:
    calm.finos.org/node: {{id}}
    calm.finos.org/deploy-rules: {{../rules.name}}-{{../rules.version}}
{{#if ../hardening}}
    app.kubernetes.io/name: {{id}}
    app.kubernetes.io/part-of: {{../serviceName}}
    app.kubernetes.io/managed-by: flux
{{/if}}
spec:
  replicas: 1
{{#if stateful}}
  # Its data is in the pod (no volume claim): never two at once during a rollout.
  strategy:
    type: Recreate
{{/if}}
  selector:
    matchLabels:
      calm.finos.org/node: {{id}}
  template:
    metadata:
      labels:
        calm.finos.org/node: {{id}}
        calm.finos.org/deploy-rules: {{../rules.name}}-{{../rules.version}}
{{#if ../hardening}}
        app.kubernetes.io/name: {{id}}
        app.kubernetes.io/part-of: {{../serviceName}}
{{/if}}
    spec:
      enableServiceLinks: false
{{#if ../hardening}}
      automountServiceAccountToken: false
{{/if}}
      containers:
        - name: {{id}}
          image: {{image}}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{containerPort}}
{{#if env.length}}
          env:
{{#each env}}
            - name: {{name}}
              value: {{{json value}}}
{{/each}}
{{/if}}
          readinessProbe:
{{#if httpProbePath}}
            httpGet:
              path: {{httpProbePath}}
              port: {{containerPort}}
{{else}}
            tcpSocket:
              port: {{containerPort}}
{{/if}}
{{#if probeDelay}}
            initialDelaySeconds: {{probeDelay}}
{{/if}}
            periodSeconds: 5
            failureThreshold: 24
{{#if ../hardening}}
          livenessProbe:
{{#if httpProbePath}}
            httpGet:
              path: {{httpProbePath}}
              port: {{containerPort}}
{{else}}
            tcpSocket:
              port: {{containerPort}}
{{/if}}
            initialDelaySeconds: 60
            periodSeconds: 10
{{/if}}
          resources:
            requests:
              cpu: {{cpu}}
              memory: {{memory}}
{{#if ../hardening}}
            limits:
              cpu: {{cpuLimit}}
              memory: {{memoryLimit}}
{{/if}}
{{#if isGateway}}
          volumeMounts:
            - name: config
              mountPath: /etc/nginx/conf.d
      volumes:
        - name: config
          configMap:
            name: gateway-config
{{/if}}
{{#if volumes.length}}
          volumeMounts:
{{#each volumes}}
            - name: {{name}}
              mountPath: {{mountPath}}
{{/each}}
      volumes:
{{#each volumes}}
        - name: {{name}}
          emptyDir: {}
{{/each}}
{{/if}}
---
apiVersion: v1
kind: Service
metadata:
  name: {{id}}
  labels:
    calm.finos.org/node: {{id}}
spec:
  selector:
    calm.finos.org/node: {{id}}
  ports:
    - port: {{servicePort}}
      targetPort: {{containerPort}}
{{/each}}
