// Generated by the starter node-service {{starterVersion}} for {{serviceName}}. No dependencies: Node's http and net.
// The starter contract: listen on $PORT, answer GET /health, serve the page and /api/info, and read what the
// deployment rules tell it (SERVICE_NAME, CALM_CONNECTIONS, CALM_DEPLOY_RULES, ...).
'use strict';

const fs = require('node:fs');
const http = require('node:http');
const net = require('node:net');
const os = require('node:os');
const path = require('node:path');

const PORT = Number(process.env.PORT || {{servicePort}});
const CONNECT_TIMEOUT_MS = 2000;
const STARTED_AT = new Date().toISOString();
const PAGE = fs.readFileSync(path.join(__dirname, 'index.html'));

let connections = [];
try {
  connections = JSON.parse(process.env.CALM_CONNECTIONS || '[]');
} catch {
  console.error('CALM_CONNECTIONS is not JSON; no connections are checked');
}

function info() {
  return {
    service: process.env.SERVICE_NAME || {{{json serviceName}}},
    description: {{{json description}}},
    owner: process.env.SERVICE_OWNER || {{{json owner}}},
    starter: 'node-service@{{starterVersion}}',
    runtime: `Node ${process.versions.node}`,
    deployRules: process.env.CALM_DEPLOY_RULES || null,
    architecture: process.env.CALM_ARCHITECTURE || {{{json architectureId}}},
    pattern: process.env.CALM_PATTERN || {{{json patternId}}},
    hostname: os.hostname(),
    startedAt: STARTED_AT,
  };
}

/** Tries a TCP connection and resolves to true when it opens. */
function isOpen(host, port) {
  return new Promise(resolve => {
    const socket = net.connect({ host, port });
    const done = open => {
      socket.destroy();
      resolve(open);
    };
    socket.setTimeout(CONNECT_TIMEOUT_MS);
    socket.once('connect', () => done(true));
    socket.once('timeout', () => done(false));
    socket.once('error', () => done(false));
  });
}

function send(res, status, body) {
  res.writeHead(status, { 'content-type': 'application/json' });
  res.end(`${JSON.stringify(body, null, 2)}\n`);
}

const server = http.createServer(async (req, res) => {
  const p = new URL(req.url, 'http://localhost').pathname;
  if (req.method !== 'GET') {
    send(res, 405, { error: 'method not allowed' });
  } else if (p === '/' || p === '/index.html') {
    res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' });
    res.end(PAGE);
  } else if (p === '/health') {
    send(res, 200, { status: 'ok' });
  } else if (p === '/api/info') {
    send(res, 200, info());
  } else if (p === '/api/connections') {
    send(res, 200, await Promise.all(connections.map(async c => ({ ...c, open: await isOpen(c.host, c.port) }))));
  } else {
    send(res, 404, { error: 'not found' });
  }
});

server.listen(PORT, '0.0.0.0', () => console.log(`${info().service} listening on ${PORT}`));
for (const signal of ['SIGTERM', 'SIGINT']) {
  process.on(signal, () => server.close(() => process.exit(0)));
}
