# Generated by bundle web-service 1.0.0
services:
  {{serviceName}}:
    # Bundle 1.0.0 renders no Dockerfile (2.0.0 adds one): build and tag your image as {{serviceName}}:latest first.
    image: {{serviceName}}:latest
    pull_policy: never
    ports:
      - "{{servicePort}}:{{servicePort}}"
    volumes:
      - ./config/application.yaml:/app/config/application.yaml:ro
    depends_on:
      - datastore
{{#if cache}}      - cache
{{/if}}{{#if messageQueue}}      - message-queue
{{/if}}{{#if observability}}      - otel-collector
{{/if}}
  datastore:
    image: {{datastore.image}}
{{#if datastore.isPostgres}}    environment:
      POSTGRES_DB: {{serviceName}}
      POSTGRES_PASSWORD: change-me
{{/if}}
{{#if cache}}
  cache:
    image: redis:7
{{/if}}
{{#if messageQueue}}
  message-queue:
    image: rabbitmq:3
{{/if}}
{{#if observability}}
  otel-collector:
    image: otel/opentelemetry-collector:0.110.0
{{/if}}
