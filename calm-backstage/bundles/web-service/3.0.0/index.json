{
  "name": "Web Service Bundle v3",
  "transformer": "web-service-transformer",
  "templates": [
    {
      "template": "README.md.hbs",
      "from": "document",
      "output": "README.md",
      "output-type": "single",
      "front-matter": {
        "inject": false
      }
    },
    {
      "template": "Dockerfile.hbs",
      "from": "document",
      "output": "Dockerfile",
      "output-type": "single"
    },
    {
      "template": "server.js.hbs",
      "from": "document",
      "output": "src/server.js",
      "output-type": "single"
    },
    {
      "template": "workloads.yaml.hbs",
      "from": "document",
      "output": "deploy/k8s/workloads.yaml",
      "output-type": "single"
    },
    {
      "template": "gateway-config.yaml.hbs",
      "from": "document",
      "output": "deploy/k8s/gateway-config.yaml",
      "output-type": "single"
    },
    {
      "template": "network-policy.yaml.hbs",
      "from": "document",
      "output": "deploy/k8s/network-policy.yaml",
      "output-type": "single"
    },
    {
      "template": "kustomization.yaml.hbs",
      "from": "document",
      "output": "deploy/k8s/kustomization.yaml",
      "output-type": "single"
    }
  ]
}
