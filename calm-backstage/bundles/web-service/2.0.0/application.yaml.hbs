# Generated by bundle web-service 2.0.0
server:
  port: {{servicePort}}
management:
  health-path: /health
datastore:
  kind: {{datastore.kind}}
{{#if datastore.isPostgres}}  url: jdbc:postgresql://datastore:{{datastore.port}}/{{serviceName}}
{{/if}}{{#if datastore.isMongodb}}  url: mongodb://datastore:{{datastore.port}}/{{serviceName}}
{{/if}}{{#if cache}}cache:
  url: redis://cache:{{cache.port}}
{{/if}}{{#if messageQueue}}messaging:
  url: amqp://message-queue:{{messageQueue.port}}
{{/if}}{{#if observability}}telemetry:
  otlp-endpoint: http://otel-collector:{{observability.port}}
{{/if}}
