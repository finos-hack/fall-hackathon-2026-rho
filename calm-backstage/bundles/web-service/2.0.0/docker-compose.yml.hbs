# Generated by bundle web-service 2.0.0
name: {{serviceName}}

services:
  {{serviceName}}:
    build:
      context: ..
    ports:
      - "{{servicePort}}:{{servicePort}}"
    depends_on:
      datastore:
        condition: service_healthy
{{#if cache}}      cache:
        condition: service_started
{{/if}}{{#if messageQueue}}      message-queue:
        condition: service_started
{{/if}}{{#if observability}}      otel-collector:
        condition: service_started
{{/if}}

  datastore:
    image: {{datastore.image}}
{{#if datastore.isPostgres}}    environment:
      POSTGRES_DB: {{serviceName}}
      POSTGRES_PASSWORD: change-me
    healthcheck:
      test: ["CMD", "pg_isready"]
{{/if}}{{#if datastore.isMongodb}}    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping').ok"]
{{/if}}
{{#if cache}}
  cache:
    image: redis:7
{{/if}}
{{#if messageQueue}}
  message-queue:
    image: rabbitmq:3-management
{{/if}}
{{#if observability}}
  otel-collector:
    image: otel/opentelemetry-collector:0.110.0
{{/if}}
