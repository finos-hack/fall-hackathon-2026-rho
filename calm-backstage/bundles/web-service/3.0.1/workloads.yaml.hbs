# Generated by bundle web-service {{bundleVersion}}: one Deployment and one Service per in-cluster node.
{{#each workloads}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{id}}
  labels:
    calm.finos.org/node: {{id}}
spec:
  replicas: 1
  selector:
    matchLabels:
      calm.finos.org/node: {{id}}
  template:
    metadata:
      labels:
        calm.finos.org/node: {{id}}
    spec:
      enableServiceLinks: false
      containers:
        - name: {{id}}
          image: {{image}}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{containerPort}}
{{#if env.length}}
          env:
{{#each env}}
            - name: {{name}}
              value: {{{json value}}}
{{/each}}
{{/if}}
          readinessProbe:
{{#if httpProbePath}}
            httpGet:
              path: {{httpProbePath}}
              port: {{containerPort}}
{{else}}
            tcpSocket:
              port: {{containerPort}}
{{/if}}
            periodSeconds: 5
          resources:
            requests:
              cpu: {{cpu}}
              memory: {{memory}}
{{#if isGateway}}
          volumeMounts:
            - name: config
              mountPath: /etc/nginx/conf.d
      volumes:
        - name: config
          configMap:
            name: gateway-config
{{/if}}
---
apiVersion: v1
kind: Service
metadata:
  name: {{id}}
  labels:
    calm.finos.org/node: {{id}}
spec:
  selector:
    calm.finos.org/node: {{id}}
  ports:
    - port: {{servicePort}}
      targetPort: {{containerPort}}
{{/each}}
