# Generated by bundle web-service {{bundleVersion}}: nothing is allowed except DNS and the architecture's
# connects relationships. Ports are the pods' ports.
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-dns
spec:
  podSelector: {}
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
{{#each policies}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{name}}
  annotations:
    calm.finos.org/relationship: {{{json relationship}}}
    calm.finos.org/protocol: {{{json protocol}}}
spec:
  podSelector:
    matchLabels:
      calm.finos.org/node: {{pod}}
{{#if isEgress}}
  policyTypes:
    - Egress
  egress:
    - to:
        - podSelector:
            matchLabels:
              calm.finos.org/node: {{peer}}
      ports:
        - protocol: TCP
          port: {{port}}
{{/if}}
{{#if isIngress}}
  policyTypes:
    - Ingress
  ingress:
{{#if peer}}
    - from:
        - podSelector:
            matchLabels:
              calm.finos.org/node: {{peer}}
      ports:
{{else}}
    - ports:
{{/if}}
        - protocol: TCP
          port: {{port}}
{{/if}}
{{/each}}
