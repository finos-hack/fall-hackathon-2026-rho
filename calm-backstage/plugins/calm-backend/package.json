{
  "name": "@internal/backstage-plugin-calm-backend",
  "description": "CALM backend plugin: POST /placeholders runs calm generate (published @finos/calm-cli) and returns the placeholder list; GET /architecture and GET /pattern feed the entity cards.",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "calm"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/errors": "^1.3.2",
    "@backstage/plugin-catalog-node": "^2.2.6",
    "@internal/backstage-plugin-calm-common": "workspace:^",
    "@internal/backstage-plugin-calm-node": "workspace:^",
    "express": "^4.22.1",
    "express-promise-router": "^4.1.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@types/express": "^4.17.21"
  },
  "files": [
    "dist"
  ]
}
