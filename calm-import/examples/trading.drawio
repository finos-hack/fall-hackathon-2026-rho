        </mxCell>
        <mxCell id="legend-db" value="Database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="960" y="295" width="90" height="55" as="geometry" />
