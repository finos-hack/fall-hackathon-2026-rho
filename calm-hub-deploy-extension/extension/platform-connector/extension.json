{
  "id": "platform-connector",
  "version": "0.1.0",
  "hubApi": 0,
  "name": "Platform Connector",
  "description": "Connects the firm's delivery platform (here GitOps on Kubernetes) to CALM Hub: it deploys architecture versions, reads what really runs, and records each deployment as a standard deployment decorator.",
  "provider": "GitOps on Kubernetes (reference)",
  "routes": [
    { "id": "tab", "method": "GET", "path": "/tab/{namespace}/{resourceType}/{resourceId}", "scope": "read", "readOnly": true },
    { "id": "status", "method": "GET", "path": "/namespaces/{namespace}/architectures/{architecture}/status", "scope": "read", "readOnly": true },
    { "id": "history", "method": "GET", "path": "/history/namespaces/{namespace}/architectures/{architecture}/deployments", "scope": "read", "readOnly": true },
    { "id": "deploy-here", "method": "POST", "path": "/deploy/{namespace}/{resourceType}/{resourceId}/{version}", "scope": "write" },
    { "id": "deploy", "method": "POST", "path": "/namespaces/{namespace}/architectures/{architecture}/versions/{version}/deployments", "scope": "write" }
  ],
  "commands": {
    "status": {
      "route": "status",
      "description": "Where an architecture's service runs: its repository, deployment rules, Flux status, the commit applied and the architecture version deployed.",
      "input": {
        "type": "object",
        "properties": {
          "namespace": { "type": "string", "description": "CALM Hub namespace" },
          "architecture": { "type": "string", "description": "Architecture name (its id in the name-based API)" }
        },
        "required": ["namespace", "architecture"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "namespace": { "type": "string" },
          "architecture": { "type": "string" },
          "managed": { "type": "boolean", "description": "The service is deployed by this extension" },
          "repository": { "type": "string" },
          "deploymentRules": { "type": "string" },
          "environment": { "type": "string" },
          "deployedVersion": { "type": "string" },
          "latestVersion": { "type": "string" },
          "ready": { "type": "boolean" },
          "message": { "type": "string" },
          "commit": { "type": "string" },
          "commitUrl": { "type": "string" }
        },
        "required": ["namespace", "architecture", "managed"]
      },
      "destructive": false,
      "idempotent": true
    },
    "history": {
      "route": "history",
      "description": "The deployment attempts for an architecture, newest first: deployments, versions refused at the controls gate (status refused, with the control evaluation's id) and a job still at the gate (status validating, no id yet).",
      "input": {
        "type": "object",
        "properties": {
          "namespace": { "type": "string" },
          "architecture": { "type": "string" }
        },
        "required": ["namespace", "architecture"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "deployments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "number", "description": "The CALM Hub decorator; absent while CALM Hub holds no record of the job" },
                "deploymentId": { "type": "string", "description": "The id the deploy command answered with, for a job not yet recorded in CALM Hub" },
                "evaluationId": { "type": "number", "description": "The control-evaluation decorator recording a refusal at the controls gate" },
                "version": { "type": "string" },
                "status": { "type": "string" },
                "startTime": { "type": "string" },
                "endTime": { "type": "string" },
                "environment": { "type": "string" },
                "requestedBy": { "type": "string" },
                "pullRequest": { "type": "string" },
                "details": { "type": "string" },
                "notes": { "type": "string" }
              },
              "required": ["status"]
            }
          }
        },
        "required": ["deployments"]
      },
      "destructive": false,
      "idempotent": true
    },
    "deploy": {
      "route": "deploy",
      "description": "Deploy an architecture version: validate it, re-render the service's deployment rules against it, merge the change and wait for Flux. Answers at once; the deployment decorator is written only once the version passes the controls gate (a refused version gets a control-evaluation decorator instead). Follow the deployment with history.",
      "input": {
        "type": "object",
        "properties": {
          "namespace": { "type": "string" },
          "architecture": { "type": "string" },
          "version": { "type": "string", "description": "Architecture version, e.g. 1.0.1" }
        },
        "required": ["namespace", "architecture", "version"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "hubApi": { "type": "number" },
          "deploymentId": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["deploymentId", "status"]
      },
      "destructive": false,
      "idempotent": true
    }
  },
  "contributes": {
    "designer-tab": [{ "id": "deployment", "title": "Deployment", "route": "tab" }],
    "action": [{ "id": "deploy-version", "title": "Deploy this version", "route": "deploy-here" }]
  }
}
