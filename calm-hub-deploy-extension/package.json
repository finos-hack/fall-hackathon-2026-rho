{
  "name": "calm-hub-deploy-extension",
  "version": "0.1.0",
  "private": true,
  "description": "A CALM Hub extension that deploys architecture versions through Git and Flux and records them as deployment decorators.",
  "license": "Apache-2.0",
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "tsc": "tsc --noEmit",
    "hub:up": "scripts/hub-up.sh"
  },
  "dependencies": {
    "@internal/backstage-plugin-calm-common": "file:../calm-backstage/plugins/calm-common",
    "@internal/backstage-plugin-calm-node": "file:../calm-backstage/plugins/calm-node",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
